# IOSForge environment template — copy to .env and fill locally.
# NEVER put real secrets in this file (it is committed). .env is gitignored.

# --- Database (PostgreSQL 16) ---
# App connection string (used by the application/SQLAlchemy).
DATABASE_URL=postgresql+psycopg://iosforge:iosforge@localhost:5432/iosforge
# Container init vars consumed by docker-compose postgres service.
# DEV-PLACEHOLDERS for local only — keep in sync with DATABASE_URL above.
POSTGRES_USER=iosforge
POSTGRES_PASSWORD=iosforge
POSTGRES_DB=iosforge
POSTGRES_PORT=5432

# --- Celery broker / result backend (Redis) ---
REDIS_URL=redis://localhost:6379/0
# Host port docker-compose exposes for redis.
REDIS_PORT=6379

# --- Artifact storage (MinIO / S3-compatible) ---
# Application-side S3 client config.
S3_ENDPOINT_URL=http://localhost:9000
# These keys double as the MinIO root credentials in docker-compose.
# DEV-PLACEHOLDERS — replace with strong values; MinIO requires secret >= 8 chars.
S3_ACCESS_KEY_ID=iosforge-dev
S3_SECRET_ACCESS_KEY=iosforge-dev-secret
S3_BUCKET=iosforge-artifacts
S3_REGION=us-east-1
# Host ports docker-compose exposes for the MinIO S3 API and web console.
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- Admin panel (SPEC §7) — internet-facing behind a TLS reverse proxy ---
# Secret for signing tokens; set a long random value in prod (e.g. `openssl rand -hex 32`).
ADMIN_SESSION_SECRET=
# Keep true in prod (HTTPS). Set false ONLY for local http smoke testing.
ADMIN_COOKIE_SECURE=true
ADMIN_SESSION_TTL_S=3600
ADMIN_UPLOAD_MAX_BYTES=209715200
ADMIN_LOGIN_MAX_ATTEMPTS=5
ADMIN_LOGIN_LOCKOUT_S=300
ADMIN_AVD=mvp
# Seed-only operator credentials (consumed by `python -m iosforge.admin.seed`, not at runtime).
ADMIN_SEED_USERNAME=
ADMIN_SEED_PASSWORD=

# --- Firebase Test Lab (EmulatorProvider, first implementation) ---
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_PATH=

# --- Admin backend provisioning (Firebase + Rowy + RevenueCat) ---
# Opt-in: emit an admin/ scaffold is always on (GENERATE_ADMIN); flip PROVISION_ADMIN
# to actually create/configure the live Firebase project + seed placeholders.
# Put the real service-account JSON OUTSIDE the repo (e.g. /var/www/IOSForge/secrets/).
GENERATE_ADMIN=true
PROVISION_ADMIN=false
FIREBASE_SA_PATH=
# FIREBASE_PROJECT_ID reused from the Test Lab block above (target project).
FIREBASE_CREATE_PROJECT=false
REVENUECAT_API_KEY=

# --- App Store Connect API (delivery / signing) ---
ASC_KEY_ID=
ASC_ISSUER_ID=
ASC_KEY_PATH=

# --- Code signing ---
APPLE_TEAM_ID=
MATCH_PASSWORD=
MATCH_GIT_URL=
